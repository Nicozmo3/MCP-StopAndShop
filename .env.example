# Configuration pour le serveur MCP StopAndShop

# Clé API Mistral AI (obligatoire)
# Obtenez votre clé sur https://console.mistral.ai
MISTRAL_API_KEY=votre_cle_api_mistral_ici

# Configuration Base de données (pour les outils existants)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=stopandshop
DB_PORT=3306

# Configuration du serveur MCP
PORT=8443
HOST=0.0.0.0
TRANSPORT=http

# Configuration SSL pour HTTPS (si TRANSPORT=https)
# Chemin vers le certificat SSL (relatif au répertoire du projet)
SSL_CERTFILE=certs/server.crt
# Chemin vers la clé privée SSL (relatif au répertoire du projet)
SSL_KEYFILE=certs/server.key
