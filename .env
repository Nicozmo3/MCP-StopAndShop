# Configuration pour le serveur MCP StopAndShop en développement local

# Clé API Mistral AI (obligatoire pour les outils d'analyse de texte)
# Obtenez votre clé sur https://console.mistral.ai
MISTRAL_API_KEY=votre_cle_api_mistral_ici

# Configuration Base de données MariaDB locale
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=stopandshop
DB_PORT=3307

# Configuration du serveur MCP
PORT=8443
HOST=0.0.0.0
TRANSPORT=https

# Configuration SSL pour HTTPS (certificats locaux pour développement)
SSL_CERTFILE=certs/server.crt
SSL_KEYFILE=certs/server.key
